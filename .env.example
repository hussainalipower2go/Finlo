# ------------------------------------------------------------------
# Finlo environment variables
# Copy this file to .env.local (local development) or add in Vercel.
# Never commit real secrets. Public browser-safe values use NEXT_PUBLIC_
# ------------------------------------------------------------------

# --- Supabase ---
# Project Settings -> API. Browser-safe (public) values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the frontend. Used by /api/admin/*,
# feature flags, feedback, and delete-account routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Assistant & Receipt Scanning (Google Gemini) ---
# Server-only key. Used by /api/ai and /api/extract-receipt.
AI_API_KEY=
# Optional: model override (default: gemini-flash-lite-latest)
AI_MODEL=gemini-flash-lite-latest

# --- App URL ---
# Used for Supabase password-reset redirect links.
# Local: http://localhost:3000   Production: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional ---
NEXT_PUBLIC_DEFAULT_CURRENCY=PKR

# --- Capacitor/Android (optional, mobile build only) ---
# Server URL baked into the Android APK WebView (see capacitor.config.ts).
# FINLO_APP_URL=https://your-project.vercel.app
# FINLO_ANDROID_DEBUG=true
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

CRON_SECRET=
